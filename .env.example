# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only. Never expose this value to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Payment providers — placeholders only. Never commit real credentials.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_BASE_URL=
PHONEPE_CLIENT_ID=
PHONEPE_CLIENT_SECRET=
PHONEPE_CLIENT_VERSION=
PHONEPE_WEBHOOK_SECRET=
PHONEPE_BASE_URL=
CASHFREE_CLIENT_ID=
CASHFREE_CLIENT_SECRET=
CASHFREE_WEBHOOK_SECRET=
CASHFREE_BASE_URL=
JIO_PG_CLIENT_ID=
JIO_PG_CLIENT_SECRET=
JIO_PG_WEBHOOK_SECRET=
JIO_PG_BASE_URL=
SABPAISA_CLIENT_ID=
SABPAISA_CLIENT_SECRET=
SABPAISA_WEBHOOK_SECRET=
SABPAISA_BASE_URL=
PAYMENT_CREDENTIAL_ENCRYPTION_KEY=

# Optional distributed rate limiting. Required before production traffic.
RATE_LIMIT_REDIS_URL=
RATE_LIMIT_REDIS_TOKEN=

# Optional observability. DSN remains server-only.
ERROR_TRACKING_DSN=
NEXT_PUBLIC_VERCEL_ANALYTICS=false

# Optional email service. Missing values disable outbound email gracefully.
SMTP_HOST=
SMTP_PORT=
